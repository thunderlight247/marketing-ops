# Copy to apps/api/.env and edit. Never commit the real .env file.
# All values below are placeholders.

# development | test | production
APP_ENV=development

# Port the HTTP API listens on.
API_PORT=8080

# debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL connection URL (URL form only, not key=value form).
# Leave empty to run the API without a database; /api/v1/health will then
# report the database as "unconfigured".
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DBNAME?sslmode=disable

# Comma-separated browser origins allowed to call the API (the web dashboard).
# Required when APP_ENV=production. Wildcards are not supported.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Authentication (Milestone 13) ------------------------------------------
# Operator API key. Every request (except /health and /ready) must include:
#   Authorization: Bearer <API_KEY>
# Required when APP_ENV=production; optional in development (auth is disabled
# when the variable is not set). Use a long random string:
#   openssl rand -hex 32
# API_KEY=<long random string>

# 64-hex character (32-byte) AES-256 key used to encrypt integration secrets at rest.
# Optional in development (defaults to a dev fallback key); required when APP_ENV=production.
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---- AI-assisted drafting (Milestone 4) -------------------------------------
# Drafting provider. With an OpenRouter key the API routes drafts through
# it; without one it uses the offline "stub" provider (deterministic
# placeholder output) so development needs no network or key. Production
# does not accept the stub.
# OPENROUTER_API_KEY=<secret from openrouter.ai>
#
# Optional model to route (OpenRouter presets define valid names), e.g.:
# AI_MODEL=anthropic/claude-3.5-haiku
#
# Optional generation timeout in seconds (default 90, allowed 5-600):
# AI_GENERATE_TIMEOUT=90

# Development/test only: override the Sanity API host to use a local mock
# for publishing adapter verification. Rejected when APP_ENV=production.
# SANITY_OPS_BASE=http://127.0.0.1:9971

# --- Publishing worker (Milestone 9) ----------------------------------------
# The worker drains due publishing jobs (scheduled publishes and retries for
# failed attempts) from the database while the API runs. It only starts when
# DATABASE_URL is configured.
#
# Scan cadence in seconds (default 15, allowed 1-3600):
# PUBLISH_WORKER_INTERVAL=15
#
# Retry attempts before a failed job waits for an operator (default 5, 1-20):
# PUBLISH_WORKER_MAX_ATTEMPTS=5
#
# Backoff after failure N is base * 2^(N-1), capped by the max delay.
# Base delay in seconds (default 30):
# PUBLISH_WORKER_BASE_DELAY=30
#
# Backoff cap in seconds (default 1800, allowed 1-86400):
# PUBLISH_WORKER_MAX_DELAY=1800
