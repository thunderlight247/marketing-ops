# Copy to apps/web/.env.local and edit. Never commit .env.local.
#
# NEXT_PUBLIC_* values are embedded in the browser bundle and visible to anyone
# who opens the dashboard. Never put secrets in this file.

# Base URL of the Go API (no trailing slash needed).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ---- Authentication (Milestone 13) ------------------------------------------
# Operator API key sent as "Authorization: Bearer <key>" on every API request.
# Must match the API_KEY set in apps/api/.env.
# Leave blank (and leave API_KEY unset server-side) for local development without auth.
# NEXT_PUBLIC_API_KEY=<same value as API_KEY in apps/api/.env>

