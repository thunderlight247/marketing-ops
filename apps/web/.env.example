# Copy to apps/web/.env.local and edit. Never commit the real file.
# These variables are server-only; do not prefix secrets with NEXT_PUBLIC_.

# Address reachable from the Next.js server (not the browser).
API_BASE_URL=http://localhost:8080
# Must match API_KEY in apps/api/.env when the API requires authentication.
# API_KEY=<long random API key>

# Single operator credentials. Use a long unique password and HTTPS in any
# non-local deployment. ASCII printable characters only; username cannot contain ':'.
# OPERATOR_USERNAME=operator
# OPERATOR_PASSWORD=<long unique password>
# Exact external origin, no trailing slash, used to reject cross-origin writes.
# WEB_ORIGIN=https://dashboard.example.com

# For trusted local development only. Never enable on a network-exposed server.
# make dev enables this for its local dashboard automatically.
# WEB_AUTH_DISABLED=true
